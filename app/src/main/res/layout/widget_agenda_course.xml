<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/agenda_course"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:background="@drawable/agenda_card" android:padding="7dp">
    <ImageView android:id="@+id/agenda_course_stripe" android:layout_width="3dp" android:layout_height="45dp"
        android:background="#50886B" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="7dp" android:orientation="vertical">
        <TextView android:id="@+id/agenda_course_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#273C32" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/agenda_course_time" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="#476555" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/agenda_course_room" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#728077" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
